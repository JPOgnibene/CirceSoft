<?xml version="1.0"?>
<package format="3">
  <name>my_diffbot_sim</name>
  <version>0.1.0</version>
  <description>Diff-drive robot in Gazebo Harmonic with a football field world (ROS 2 Jazzy + ros_gz bridge).</description>
  <maintainer email="you@example.com">You</maintainer>
  <license>Apache-2.0</license>

  <!-- Python package build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS/Gazebo runtime -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <!-- Messages your node uses -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- Launch and helpers used in launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Python libs (use rosdep key) -->
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
